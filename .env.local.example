# Anthropic API key — used for narrative/photo-scoring analysis (Claude vision)
ANTHROPIC_API_KEY=

# fal.ai API key — used server-side for the image-edit enhancement pass
# (fal-ai/nano-banana-pro/edit). Generate one at fal.ai/dashboard/keys.
# (OpenArt itself has no server-callable REST API — only an MCP/OAuth
# connection for agent sessions — so the enhancement step calls fal.ai,
# which hosts the same underlying models, directly instead.)
FAL_KEY=

# Vercel Blob read/write token — from the Blob store in your Vercel project
# settings (Storage tab). Required for storing uploads + enhanced outputs.
BLOB_READ_WRITE_TOKEN=

# Shared passphrase gating access to the app (it spends paid API credits).
ACCESS_PASSWORD=
